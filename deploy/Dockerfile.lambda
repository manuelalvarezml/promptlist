FROM rust:1.89-alpine AS build
RUN apk add --no-cache musl-dev build-base
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY deploy/build-stub.rs ./src/main.rs
COPY deploy/build-stub.rs ./src/lib.rs
RUN cargo build --release --locked --bin promptlist
COPY src ./src
COPY assets ./assets
RUN touch src/lib.rs src/main.rs && cargo build --release --locked --bin bootstrap --bin cloud-smoke --bin cloud-import

FROM scratch AS artifact
COPY --from=build /work/target/release/bootstrap /bootstrap
COPY --from=build /work/target/release/cloud-smoke /cloud-smoke
COPY --from=build /work/target/release/cloud-import /cloud-import
