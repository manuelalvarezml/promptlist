[Unit]
Description=Promptlist private Spotify beta
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=promptlist
Group=promptlist
WorkingDirectory=/opt/promptlist/current
EnvironmentFile=/etc/promptlist/environment
Environment=PROMPTLIST_MODE=hosted
Environment=PROMPTLIST_DATA_DIR=/var/lib/promptlist
Environment=PROMPTLIST_PORT=8787
ExecStart=/opt/promptlist/current/promptlist
Restart=on-failure
RestartSec=5
StateDirectory=promptlist
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=300M
TasksMax=128
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
