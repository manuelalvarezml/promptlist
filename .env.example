# Standalone project. Never put real credentials in this example file.
# Loaded by the local Rust app. OpenAI translates request text only.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback
LASTFM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional, only after an approved paid fallback trial:
# SOUNDSTAT_API_KEY=

# AWS is not needed for the local access spike. Use a named CLI/SSO profile later.
# AWS_PROFILE=
# AWS_REGION=
